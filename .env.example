# Copie este arquivo para ".env" (mesma pasta) e preencha com os valores
# do SEU projeto Supabase. Nunca cole valores reais aqui neste arquivo
# .env.example — ele fica no git; o .env de verdade não (veja .gitignore).
#
# Onde encontrar: no painel do Supabase, abra seu projeto e vá em
# Project Settings > API. "Project URL" é a primeira variável, "anon
# public" (dentro de "Project API keys") é a segunda.
#
# IMPORTANTE: VITE_SUPABASE_URL é só a URL base do projeto, SEM nenhum
# caminho depois do domínio (nada de /rest/v1/ no final). O SDK do
# Supabase já monta esse caminho sozinho — se colar a URL com /rest/v1/
# junto (algumas telas do painel mostram a "Data API URL" assim), toda
# chamada quebra com um erro tipo "PGRST125: Invalid path specified".
#
# A anon key é segura para expor no navegador — ela só permite o que as
# políticas de Row Level Security (RLS) autorizarem. Ver supabase/schema.sql.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-anon-public-key

# Domínio público do site, sem barra no final (ex.: https://familia.com.br).
# Usado na tag <link rel="canonical"> (src/seo.js) e para gerar
# public/robots.txt + public/sitemap.xml no "npm run build"
# (scripts/generate-seo-files.mjs). Opcional: sem ela, o build de produção
# já usa https://familiapintoarrudaleda.com.br.
# VITE_SITE_URL=https://familiapintoarrudaleda.com.br
